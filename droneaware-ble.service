[Unit]
Description=DroneAware BLE Remote ID Feeder
After=network-online.target bluetooth.target droneaware-bt-select.service
# Wants, not Requires: the selector choosing an adapter is useful, but its
# failing -- no config.txt on a non-Pi host, no adapter found, or an operator
# disabling it -- must not stop the BLE feeder from starting. The feeder already
# reports FAULT on its own when there is no working adapter.
Wants=network-online.target droneaware-bt-select.service

[Service]
Type=simple
User=root
EnvironmentFile=/opt/droneaware/config.env
ExecStartPre=/usr/sbin/rfkill unblock bluetooth
# The binaries are self-extracting: each unpacks its bundle into a temp
# directory and reads from it for the life of the process. The daily tmpfiles
# clean deletes anything in /tmp older than 10 days, which on a node left
# running removes a live process's own files underneath it — the local map
# page loses its interface files, and the process can die outright. A private
# /tmp is excluded from that cleanup (/usr/lib/tmpfiles.d/systemd-tmp.conf),
# so a service keeps what it unpacked for as long as it runs.
PrivateTmp=yes
ExecStart=/opt/droneaware/ble_feeder \
    --node-id ${NODE_ID} \
    --server ${SERVER_URL} \
    --adapter ${BLE_ADAPTER} \
    --adapter-mac ${BLE_ADAPTER_MAC} \
    --batch-size ${BATCH_SIZE} \
    --flush-interval ${FLUSH_INTERVAL}
# The feeder flushes undelivered detections to the on-disk spool on SIGTERM.
# The default stop timeout is generous, but naming it makes the dependency
# explicit: shortening it below the flush would reintroduce the data loss the
# handler exists to prevent.
TimeoutStopSec=30
# Creates /var/lib/droneaware (0755, root) before the feeder starts, so the
# spool never has to race three feeder processes to mkdir it.
StateDirectory=droneaware
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=droneaware-ble

[Install]
WantedBy=multi-user.target
