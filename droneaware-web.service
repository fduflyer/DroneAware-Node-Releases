[Unit]
Description=DroneAware Local Web UI
Documentation=https://github.com/fduflyer/DroneAware-Node-Releases
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/droneaware/config.env

# 🚨 Enforce the access this unit needs, every start, rather than trusting
# whatever the installer left behind. A fresh install reached first boot with
# config.env not readable by this service and nothing in the log to say why;
# the repair only happened later because `droneaware refresh` re-applies the
# same grant as a side effect. The cause was never established — the evidence
# was in a volatile journal — so this closes the class instead of the instance.
#
# The leading "+" runs as root before the unit drops to User=droneaware.
# Idempotent, and deliberately ends in `true`: a node without the group yet
# must still start and say so, not fail to boot its own diagnostics.
ExecStartPre=+/bin/sh -c 'chgrp droneaware /opt/droneaware /opt/droneaware/config.env 2>/dev/null; \
                          chmod 2775 /opt/droneaware 2>/dev/null; \
                          chmod 660 /opt/droneaware/config.env 2>/dev/null; true'

# The binaries are self-extracting: each unpacks its bundle into a temp
# directory and reads from it for the life of the process. The daily tmpfiles
# clean deletes anything in /tmp older than 10 days, which on a node left
# running removes a live process's own files underneath it — the local map
# page loses its interface files, and the process can die outright. A private
# /tmp is excluded from that cleanup (/usr/lib/tmpfiles.d/systemd-tmp.conf),
# so a service keeps what it unpacked for as long as it runs.
PrivateTmp=yes
ExecStart=/opt/droneaware/web_ui
Restart=on-failure
RestartSec=5
User=droneaware
Group=droneaware

# The Web UI reads only world-readable tmpfs files written by the feeders
# (/run/droneaware/detections.jsonl, /run/droneaware/gps_state.json) and
# serves HTTP on an unprivileged port. Runs as the unprivileged droneaware
# user — config.env env vars are loaded via EnvironmentFile regardless of
# the file's own permissions, which is why a broken chmod shows up as an
# unwritable settings panel rather than a service that fails to start.

[Install]
WantedBy=multi-user.target
