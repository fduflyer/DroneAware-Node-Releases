cmd_test() {
    require_root "test"

    local dry_run=0
    [[ "${2:-}" == "--dry-run" ]] && dry_run=1

    # Read node config
    local cfg="${INSTALL_DIR}/config.env"
    local node_id lat lon iface server_url token
    node_id=$(   _cfg_get "$cfg" NODE_ID)
    lat=$(       _cfg_get "$cfg" NODE_LAT)
    lon=$(       _cfg_get "$cfg" NODE_LON)
    iface=$(     _cfg_get "$cfg" WIFI_ADAPTER)
    server_url=$(_cfg_get "$cfg" SERVER_URL)
    iface="${iface:-wlan1}"
    server_url="${server_url:-https://api.droneaware.io/api}"
    token=$(cat /etc/droneaware/token 2>/dev/null | tr -d '[:space:]')
    [[ -z "$token" ]] && fatal "No node credential found. Re-run the installer to enroll this node."

    # WiFi adapter must exist before we contact the server (avoids wasting a
    # rate-limit slot) or run the embedded transmitter (avoids ENODEV crash on
    # missing iface). Fail fast with an actionable message.
    if [[ -z "$iface" || ! -d "/sys/class/net/${iface}" ]]; then
        echo ""
        echo -e "  ${RED}✗  Cannot run test — WiFi adapter '${iface:-<none>}' not present.${NC}"
        echo ""
        echo "  This command transmits a Remote ID beacon, which requires a USB"
        echo "  monitor-mode adapter (e.g. Alfa AWUS036N)."
        echo ""
        echo "  Connect an adapter and re-run the installer to enable WiFi testing."
        echo ""
        exit 1
    fi

    # Fall back to GPS fix if available and static coords are missing
    if [[ -z "$lat" || "$lat" == "0" || -z "$lon" || "$lon" == "0" ]]; then
        local gps_dev
        gps_dev=$(_cfg_get "$cfg" GPS_DEVICE)
        if [[ -n "$gps_dev" && -e "$gps_dev" ]]; then
            local nmea
            nmea=$(stty -F "$gps_dev" 4800 2>/dev/null; timeout 8 cat "$gps_dev" 2>/dev/null \
                | grep -m1 '^\$GPRMC.*,A,')
            if [[ -n "$nmea" ]]; then
                lat=$(echo "$nmea" | python3 -c "
import sys, re
parts = sys.stdin.read().strip().split(',')
d=int(float(parts[3])/100); m=float(parts[3])-d*100
lat=round(d+m/60,6)
if parts[4]=='S': lat=-lat
d=int(float(parts[5])/100); m=float(parts[5])-d*100
lon=round(d+m/60,6)
if parts[6].split('*')[0]=='W': lon=-lon
print(lat, lon)" | awk '{print $1}')
                lon=$(echo "$nmea" | python3 -c "
import sys
parts = sys.stdin.read().strip().split(',')
d=int(float(parts[5])/100); m=float(parts[5])-d*100
lon=round(d+m/60,6)
if parts[6].split('*')[0]=='W': lon=-lon
print(lon)")
            fi
        fi
    fi

    [[ -z "$lat" || "$lat" == "0" ]] && \
        fatal "No location configured. Set NODE_LAT/NODE_LON in /opt/droneaware/config.env first."

    # Build test UAS_ID: TESTFA + up to 8 chars of node_id (uppercase, alphanumeric)
    local test_id
    test_id="TESTFA$(echo "$node_id" | tr '[:lower:]' '[:upper:]' | tr -dc 'A-Z0-9' | \
        head -c 8 | awk '{printf "%-8s", $0}' | tr ' ' '0')"

    echo ""
    echo -e "${BOLD}DroneAware Test Flight${NC}"
    echo ""
    echo "  Node     : ${node_id}"
    echo "  Test ID  : ${test_id}"
    echo "  Location : ${lat}, ${lon}"
    echo "  Interface: ${iface}"
    echo ""

    # Ask the server for permission — it is the source of truth for rate limits
    echo "  Checking with server..."
    local start_resp http_status start_body
    start_resp=$(curl -s --max-time 10 \
        -o /tmp/da_test_start.json \
        -w "%{http_code}" \
        -X POST \
        -H "X-Node-Token: ${token}" \
        "${server_url}/nodes/${node_id}/test/start" 2>/dev/null) || true
    http_status="$start_resp"
    start_body=$(cat /tmp/da_test_start.json 2>/dev/null || true)
    rm -f /tmp/da_test_start.json

    case "$http_status" in
        200)
            local remaining started_at
            remaining=$(echo "$start_body" | python3 -c \
                "import sys,json; d=json.load(sys.stdin); print(d.get('remaining_in_hour',''))" 2>/dev/null || true)
            started_at=$(echo "$start_body" | python3 -c \
                "import sys,json; d=json.load(sys.stdin); print(d.get('started_at',''))" 2>/dev/null || true)
            info "Test authorized by server.${remaining:+  (${remaining} more allowed this hour)}"
            [[ -n "$started_at" ]] && echo "  Started    : ${started_at}"
            ;;
        401)
            fatal "Node authentication failed — re-run installer if this persists."
            ;;
        403)
            local msg
            msg=$(echo "$start_body" | python3 -c \
                "import sys,json; print(json.load(sys.stdin).get('detail','Access denied.'))" 2>/dev/null || true)
            fatal "${msg:-Access denied.}"
            ;;
        404)
            fatal "Node ID not recognized — re-run installer."
            ;;
        429)
            local user_msg
            user_msg=$(echo "$start_body" | python3 -c \
                "import sys,json
d=json.load(sys.stdin)
detail=d.get('detail',{})
print(detail.get('message', str(detail)))" 2>/dev/null || true)
            echo -e "\n  ${YELLOW}!${NC}  ${user_msg:-Rate limit reached. Try again later.}"
            echo ""
            exit 1
            ;;
        000|"")
            fatal "Could not reach server. Check internet connection."
            ;;
        *)
            fatal "Unexpected server response (HTTP ${http_status}). Try again later."
            ;;
    esac

    if [[ "$dry_run" == "1" ]]; then
        info "Dry run — server says OK. No transmission sent."
        echo ""
        exit 0
    fi

    echo ""
    echo "  Transmitting 60-second test flight..."
    echo "  Check your My Nodes page — a test detection should appear within 30s."
    echo ""

    # Transmit test beacons via Python (embedded)
    python3 - "$iface" "$lat" "$lon" "$test_id" <<'PYEOF'
import sys, socket, struct, time, math

iface, lat, lon, uas_id = sys.argv[1], float(sys.argv[2]), float(sys.argv[3]), sys.argv[4]

# --- ODID builders (ASTM F3411-22a correct byte layout) ---

def build_basic_id(uas_id):
    msg = bytearray(25)
    msg[0] = 0x00          # type=Basic ID, protocol version=0
    msg[1] = 0x12          # id_type=1 (Serial), ua_type=2 (Multirotor)
    msg[2:2+len(uas_id)] = uas_id.encode('ascii')[:20]
    return bytes(msg)

def build_location(lat, lon, alt_geo=0.0, vspeed=0.0, heading=0.0):
    # F3411-22a Location message byte layout:
    # 0: type+version  1: status byte  2: track direction (0-179)
    # 3: speed  4: vert_speed  5-8: lat  9-12: lon
    # 13-14: pressure_alt  15-16: geodetic_alt  17-18: height_agl
    # 19-24: accuracy/timestamp/reserved
    msg = bytearray(25)
    msg[0] = 0x10  # type=Location/Vector

    # Status byte: bit0=speed_mult(0=x0.25), bit1=EW_dir, bit2=height_type
    ew_dir = 1 if heading >= 180 else 0
    msg[1] = (ew_dir << 1)

    # Byte 2: track direction 0-179° (EW bit adds 180° for full 360)
    msg[2] = int(heading) % 180

    # Byte 3: speed (stationary = 0)
    msg[3] = 0

    # Byte 4: vertical speed encoded as (vspeed + 62) / 0.5
    msg[4] = max(0, min(254, int((vspeed + 62.0) / 0.5)))

    # Bytes 5-8: latitude
    struct.pack_into('<i', msg, 5, int(lat * 1e7))

    # Bytes 9-12: longitude
    struct.pack_into('<i', msg, 9, int(lon * 1e7))

    # Bytes 13-14: pressure altitude = (alt + 1000) / 0.5
    alt_enc = max(0, int((alt_geo + 1000.0) / 0.5))
    struct.pack_into('<H', msg, 13, alt_enc)

    # Bytes 15-16: geodetic altitude
    struct.pack_into('<H', msg, 15, alt_enc)

    # Bytes 17-18: height AGL — raw 2002 decodes to 1.0m
    # (server treats raw 0x0000 as unpopulated/None)
    struct.pack_into('<H', msg, 17, 2002)

    return bytes(msg)

def build_system_msg(op_lat, op_lon, alt_takeoff=0.0):
    # F3411-22a System message byte layout (server-verified offsets):
    # 0: type+version  1: op_location_type+classification
    # 2-5: op_lat  6-9: op_lon
    # 10-11: area_count  12: area_radius
    # 13-14: alt_takeoff_geo
    msg = bytearray(25)
    msg[0] = 0x40  # type=System
    msg[1] = 0x00  # op_location_type=0 (takeoff), classification=0
    struct.pack_into('<i', msg, 2, int(op_lat * 1e7))   # operator lat
    struct.pack_into('<i', msg, 6, int(op_lon * 1e7))   # operator lon
    struct.pack_into('<H', msg, 10, 1)                   # area_count = 1
    msg[12] = 0                                          # area_radius = 0 (point)
    struct.pack_into('<H', msg, 13, max(0, int((alt_takeoff + 1000.0) / 0.5)))
    return bytes(msg)

def build_message_pack(messages):
    pack = bytearray(3 + 25 * len(messages))
    pack[0] = 0xF0; pack[1] = 25; pack[2] = len(messages)
    for i, m in enumerate(messages):
        pack[3 + i*25:3 + (i+1)*25] = m[:25]
    return bytes(pack)

def build_beacon(src_mac, payload):
    radiotap = struct.pack('<BBHI', 0, 0, 8, 0)
    fc = bytes([0x80, 0x00])
    dur = bytes([0x00, 0x00])
    da = bytes([0xFF]*6)
    rid_data = bytes([0xFA, 0x0B, 0xBC, 0x0D]) + payload
    rid_ie = bytes([0xDD, len(rid_data)]) + rid_data
    body = (bytes(8) + struct.pack('<H', 100) + bytes([0x01, 0x00]) +
            bytes([0x00, 0x00]) +
            bytes([0x01, 0x08, 0x82, 0x84, 0x8B, 0x96, 0x24, 0x30, 0x48, 0x6C]) +
            rid_ie)
    frame = radiotap + fc + dur + da + src_mac + src_mac + bytes([0x00, 0x00]) + body
    return frame

# Flight path: paper-airplane shape (simplified) centred on node location
# Offsets in degrees (~0.0001 deg ≈ 11m)
R = 0.0004   # ~44m radius
waypoints = []
# Nose of plane (forward point)
waypoints.append((lat + R*1.5, lon))
# Right wing tip
waypoints.append((lat - R*0.5, lon + R*1.2))
# Tail centre
waypoints.append((lat - R*0.8, lon))
# Left wing tip
waypoints.append((lat - R*0.5, lon - R*1.2))
# Back to nose
waypoints.append((lat + R*1.5, lon))
# Tight circle around centre to finish
for i in range(8):
    angle = math.radians(i * 45)
    waypoints.append((lat + R*0.4*math.sin(angle), lon + R*0.4*math.cos(angle)))

src_mac = bytes([0x60, 0x60, 0x1F, 0x00, 0x01, 0x02])
basic_id  = build_basic_id(uas_id)
system_msg = build_system_msg(lat, lon)   # operator = node location

sock = socket.socket(socket.AF_PACKET, socket.SOCK_RAW)
sock.bind((iface, 0))

steps    = len(waypoints)
interval = 60.0 / steps

for i, (wlat, wlon) in enumerate(waypoints):
    location = build_location(wlat, wlon, alt_geo=0.0, vspeed=0.0, heading=0.0)
    pack = build_message_pack([basic_id, location, system_msg])
    frame = build_beacon(src_mac, pack)

    # Send 3 times to cover channel hopper cycle
    for _ in range(3):
        try:
            sock.send(frame)
        except Exception:
            pass
        time.sleep(0.3)

    print(f"  [{i+1}/{steps}] lat={wlat:.6f} lon={wlon:.6f}")
    time.sleep(max(0, interval - 0.9))

sock.close()
print("\n  Transmission complete.")
PYEOF

    # Check local detection ring buffer (per-channel breakdown so the
    # operator can see whether 2.4 GHz and 5 GHz radio paths both received).
    echo ""
    echo "  Checking local detection buffer..."
    sleep 3

    local stats
    stats=$(python3 - "$test_id" 2>/dev/null <<'PYJSON'
import json, sys
test_id = sys.argv[1]
counts = {}
total = 0
try:
    with open("/run/droneaware/detections.jsonl") as f:
        for line in f:
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            # LocalPublisher flattens the decoded sub-message into top-level
            # keys: 'id' holds uas_id (only present for Basic ID events).
            if e.get("id") != test_id:
                continue
            total += 1
            ch = e.get("channel")
            counts[ch] = counts.get(ch, 0) + 1
except FileNotFoundError:
    pass
print(total, counts.get(6, 0), counts.get(149, 0))
PYJSON
)

    local total ch6 ch149
    read -r total ch6 ch149 <<< "${stats:-0 0 0}"

    if [[ "$total" -eq 0 ]]; then
        warn "No local detection found yet — the server may still be processing."
        warn "Check your My Nodes page in 30 seconds."
    else
        info "Local detection confirmed — ${total} events captured"
        echo "       2.4 GHz (ch  6) : ${ch6}"
        echo "       5 GHz  (ch 149) : ${ch149}"
        if [[ "$ch6" -gt 0 && "$ch149" -gt 0 ]]; then
            info "Both bands receiving — radio fully functional."
        fi
    fi
    echo ""
}

cmd_install_webui() {
    require_root "install-webui"
    echo ""
    echo -e "${BOLD}DroneAware Local Web UI — Install${NC}"
    echo ""

    # The Web UI requires an enrolled node. The token at
    # /etc/droneaware/token is the enrollment artifact — if it's missing,
    # install.sh has not completed successfully and there's no point
    # installing a viewer for a non-functional detection pipeline.
    if [[ ! -f /etc/droneaware/token ]]; then
        fatal "No node credential found at /etc/droneaware/token.
       The Web UI requires an enrolled node. Run sudo bash install.sh first
       to register your account and enroll this node, then re-run
       install-webui to add the local Web UI."
    fi

    # If the service is already installed, refresh-only mode.
    if [[ -f /etc/systemd/system/droneaware-web.service ]] && [[ -x "${INSTALL_DIR}/web_ui" ]]; then
        info "Web UI is already installed."
        local web_ip
        web_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
        [[ -z "$web_ip" ]] && web_ip="<pi-ip>"
        echo "       Status:   $(systemctl is-active droneaware-web 2>/dev/null || echo 'unknown')"
        echo "       URL:      http://${web_ip}:5000/"
        echo "       To update the binary, run: sudo droneaware update"
        echo ""
        return 0
    fi

    # RAM check — same logic as install.sh, but operator already has a
    # running node so they probably know what they're doing if RAM is tight.
    local total_ram_mb
    total_ram_mb=$(awk '/MemTotal/ { print int($2/1024) }' /proc/meminfo)
    if [ "$total_ram_mb" -lt 700 ]; then
        warn "Limited RAM detected (${total_ram_mb} MB)"
        echo "    The local Web UI uses ~80 MB which may push this hardware into"
        echo "    swap. Recommended to skip the Web UI on Pi Zero / Pi 1 / Pi 2 tier."
        echo ""
        read -rp "  Install anyway? [y/N] " yn </dev/tty
        [[ "$yn" =~ ^[Yy] ]] || { info "Skipped."; return 0; }
    fi

    # Resolve the BINARY_VERSION currently installed (operator's running
    # firmware) so the web_ui binary we download matches.
    local current_version
    current_version=$(cat "$VERSION_FILE" 2>/dev/null)
    [[ -z "$current_version" ]] && fatal "Cannot determine installed firmware version (missing ${VERSION_FILE})."

    local base_url="https://github.com/${GITHUB_REPO}/releases/download/${current_version}"
    echo "  Downloading web_ui (${current_version})..."
    if ! curl -fsSL --retry 3 "${base_url}/web_ui" -o /tmp/da_web_ui; then
        fatal "Web UI binary download failed. Check your internet connection and try again."
    fi
    chmod +x /tmp/da_web_ui
    cp /tmp/da_web_ui "${INSTALL_DIR}/web_ui"
    rm -f /tmp/da_web_ui
    ln -sf "${INSTALL_DIR}/web_ui" /usr/local/bin/web_ui 2>/dev/null || true

    echo "  Installing systemd unit..."
    if ! curl -fsSL --retry 3 \
            "${base_url}/droneaware-web.service" \
            -o /etc/systemd/system/droneaware-web.service; then
        rm -f "${INSTALL_DIR}/web_ui" /usr/local/bin/web_ui
        fatal "droneaware-web.service download failed. Web UI binary cleaned up."
    fi

    # Ensure droneaware user exists for User=droneaware in the unit.
    if ! getent passwd droneaware >/dev/null; then
        useradd --system --shell /bin/false --no-create-home droneaware 2>/dev/null || true
        info "Created droneaware system user for Web UI."
    fi
    chown droneaware:droneaware "${INSTALL_DIR}/web_ui" 2>/dev/null || true

    # Bump LocalPublisher buffer + add port (idempotent additions).
    if grep -q '^DRONEAWARE_LOCAL_BUFFER_MAX_BYTES=' "${INSTALL_DIR}/config.env"; then
        sed -i 's/^DRONEAWARE_LOCAL_BUFFER_MAX_BYTES=.*/DRONEAWARE_LOCAL_BUFFER_MAX_BYTES=50000000/' \
            "${INSTALL_DIR}/config.env"
    else
        echo "DRONEAWARE_LOCAL_BUFFER_MAX_BYTES=50000000" >> "${INSTALL_DIR}/config.env"
    fi
    if ! grep -q '^DRONEAWARE_WEB_PORT=' "${INSTALL_DIR}/config.env"; then
        echo "DRONEAWARE_WEB_PORT=5000" >> "${INSTALL_DIR}/config.env"
    fi

    # Run the full release migration so operators who land here via the
    # post-install opt-in path (not cmd_update) still get every config
    # key the current release introduces — including
    # DRONEAWARE_LOCAL_UDP_TARGETS, which is feeder-side, not Web-UI-
    # specific, and so isn't covered by the two direct writes above.
    # migrate_config_env is idempotent (every block grep-gated), so the
    # extra call is harmless when migrate already ran via cmd_update.
    migrate_config_env

    # Restart feeders if needed to pick up the buffer bump, then start
    # the Web UI immediately (this is the post-install path — operator
    # has a running node, no reason to force a reboot).
    systemctl daemon-reload
    systemctl restart droneaware-wifi 2>/dev/null || true
    systemctl restart droneaware-ble  2>/dev/null || true
    systemctl enable  droneaware-web > /dev/null 2>&1
    systemctl start   droneaware-web

    sleep 2
    if systemctl is-active --quiet droneaware-web; then
        local web_ip
        web_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
        [[ -z "$web_ip" ]] && web_ip="<pi-ip>"
        info "Web UI installed and running."
        echo ""
        echo "  URL:  http://${web_ip}:5000/"
        echo ""
        echo "  Available on your LAN. Connect from any device on the same"
        echo "  network to view live detections."
        echo ""
    else
        warn "Web UI installed but service did not start cleanly."
        warn "Check: sudo journalctl -u droneaware-web -n 30"
    fi
}

cmd_gps_diagnose() {
    require_root "gps-diagnose"
    echo ""
    echo -e "${BOLD}DroneAware GPS Diagnostic${NC}"
    echo ""

    local cfg="${INSTALL_DIR}/config.env"
    local gps_dev gps_baud node_mobile
    gps_dev=$(_cfg_get "$cfg" GPS_DEVICE)
    gps_baud=$(_cfg_get "$cfg" GPS_BAUD)
    node_mobile=$(_cfg_get "$cfg" NODE_MOBILE)

    echo "  Config (${cfg}):"
    printf  "    GPS_DEVICE   = %s\n" "${gps_dev:-<empty>}"
    printf  "    GPS_BAUD     = %s\n" "${gps_baud:-<empty — will auto-detect>}"
    printf  "    NODE_MOBILE  = %s\n" "${node_mobile:-<empty>}"
    echo ""

    # If GPS_DEVICE is empty in config.env but wifi_feeder auto-discovered
    # a device, use the state file's device path so the diagnostic still
    # shows something useful. This is the common case for mobile nodes
    # since install.sh writes GPS_DEVICE= empty and lets find_gps_device()
    # probe /dev/ttyUSB* at feeder startup. Track the source so the
    # display makes the fallback visible.
    local device_source="config.env"
    if [[ -z "$gps_dev" ]] && [[ -r /run/droneaware/gps_state.json ]]; then
        gps_dev=$(python3 -c 'import json; s=json.load(open("/run/droneaware/gps_state.json")); print(s.get("device") or "")' 2>/dev/null)
        if [[ -n "$gps_dev" ]]; then
            device_source="auto-discovered (from /run/droneaware/gps_state.json)"
            echo "  Effective GPS device:"
            printf  "    %s   (%s)\n" "$gps_dev" "$device_source"
            echo ""
        fi
    fi

    if [[ -z "$gps_dev" ]]; then
        warn "GPS_DEVICE not set and no wifi_feeder state file — this is a static node without GPS, or GPS auto-discovery hasn't run yet."
        warn "Nothing to diagnose. Re-run install.sh to configure GPS, or set GPS_DEVICE in ${cfg} manually."
        echo ""
        return 0
    fi

    echo "  Device:"
    if [[ -e "$gps_dev" ]]; then
        info "$gps_dev exists"
    else
        echo -e "    ${RED}✗${NC}  $gps_dev does NOT exist — puck unplugged? kernel driver missing?"
        echo "    Recent USB messages: sudo dmesg | tail -20"
        echo ""
        return 0
    fi
    # Permissions — droneaware user needs dialout group to read /dev/tty*
    if [[ -r "$gps_dev" ]]; then
        info "readable"
    else
        warn "not readable by current user (this shouldn't matter — droneaware user access is what counts)"
    fi
    # Driver hint from dmesg (best effort)
    local drv
    drv=$(dmesg 2>/dev/null | grep -iE "ch341|pl2303|cp210|ftdi|cdc_acm" | tail -1)
    [[ -n "$drv" ]] && echo "    kernel: $drv" | cut -c1-140
    echo ""

    echo "  Port ownership (fuser):"
    local owners
    owners=$(fuser -v "$gps_dev" 2>&1 | tail -n +2)
    if [[ -z "$owners" ]]; then
        info "no process holds the port"
    else
        # Look for gpsd or wifi_feeder in the ownership list
        if echo "$owners" | grep -q gpsd; then
            echo -e "    ${RED}✗${NC}  gpsd holds the port — DroneAware cannot read GPS"
            echo "$owners" | sed 's/^/      /'
            echo ""
            echo "  Remediation:"
            echo "    sudo systemctl stop gpsd gpsd.socket"
            echo "    sudo systemctl mask gpsd gpsd.socket"
            echo "    sudo pkill -x gpsd"
            echo "    # then re-run this command"
            echo ""
            return 0
        elif echo "$owners" | grep -qE "wifi_feeder|python"; then
            info "held by wifi_feeder (expected)"
            echo "$owners" | sed 's/^/      /'
        else
            warn "held by unknown process"
            echo "$owners" | sed 's/^/      /'
        fi
    fi
    echo ""

    # gpsd latent-risk check: gpsd may be installed and enabled but not
    # currently holding the port (its default behavior is to open the
    # device on-demand when a client connects). fuser doesn't see this
    # case, but the moment the operator runs cgps / gpspipe / etc., the
    # port gets seized. Flag it proactively — same signals as the
    # installer's _check_gpsd_conflict.
    echo "  gpsd status:"
    local gpsd_present=no
    if systemctl is-enabled gpsd.socket >/dev/null 2>&1 || \
       systemctl is-active gpsd >/dev/null 2>&1 || \
       systemctl is-active gpsd.socket >/dev/null 2>&1 || \
       dpkg -l gpsd 2>/dev/null | grep -q '^ii'; then
        gpsd_present=yes
    fi
    if [[ "$gpsd_present" == "no" ]]; then
        info "not installed — no latent conflict"
    else
        if echo "$owners" | grep -q gpsd; then
            warn "actively holding the port (see above)"
        else
            warn "installed and enabled — will seize the port on next cgps / gpspipe / gpsctl invocation"
            echo "    Recommended: sudo systemctl mask gpsd gpsd.socket"
            echo "                 sudo apt purge gpsd    # keep gpsd-clients for the gpsctl utility"
        fi
    fi
    echo ""

    echo "  Protocol detection:"
    # If wifi_feeder holds the port, skip live sniffing (would fail) and
    # report from the state file instead. Otherwise probe fresh.
    local proto="" baud=""
    if echo "$owners" | grep -qE "wifi_feeder|python"; then
        echo "    (port held by wifi_feeder — reporting from state file, not re-sniffing)"
    else
        local sniff
        sniff=$(_sniff_gps_protocol "$gps_dev")
        proto=$(echo "$sniff" | awk '{print $1}')
        baud=$(echo "$sniff" | awk '{print $2}')
        case "$proto" in
            nmea)    info "NMEA detected at $baud baud" ;;
            sirf)    warn "SiRF binary detected at $baud baud — DroneAware needs NMEA" ;;
            ubx)     warn "u-blox UBX detected at $baud baud — DroneAware needs NMEA" ;;
            unknown) warn "no known protocol detected at any baud (4800/9600/38400)" ;;
        esac
    fi
    echo ""

    echo "  Recent GPS state (/run/droneaware/gps_state.json):"
    python3 - <<'PY'
import json, time, sys
try:
    with open("/run/droneaware/gps_state.json") as f:
        s = json.load(f)
except FileNotFoundError:
    print("    state file missing — wifi_feeder not running, or hasn't written yet")
    sys.exit(0)
except Exception as e:
    print(f"    state file unreadable: {e}")
    sys.exit(0)
age = int(time.time() - (s.get("updated_at") or 0))
print(f"    age:          {age}s")
print(f"    status:       {s.get('status')}")
print(f"    protocol:     {s.get('protocol')}")
print(f"    baud:         {s.get('baud')}")
print(f"    fix_quality:  {s.get('fix_quality')}")
print(f"    sats_in_use:  {s.get('sats_in_use')}")
print(f"    lat, lon:     {s.get('lat')}, {s.get('lon')}")
PY
    echo ""

    # Verdict: reads the effective protocol. If we did a live sniff, use
    # that. If the sniff was skipped (wifi_feeder holds the port — the
    # common case), fall back to the state file's protocol field so the
    # verdict reflects what the feeder is actually seeing rather than
    # printing an unhelpful "skipped" message.
    echo "  Verdict:"
    local effective_proto="$proto"
    if [[ -z "$effective_proto" ]] && [[ -r /run/droneaware/gps_state.json ]]; then
        effective_proto=$(python3 -c 'import json; s=json.load(open("/run/droneaware/gps_state.json")); print(s.get("protocol") or "")' 2>/dev/null)
    fi
    case "$effective_proto" in
        nmea)    echo -e "    ${GREEN}GPS looks healthy.${NC} If sats_in_use is 0, wait for sky view + satellite lock." ;;
        sirf|ubx)
            echo "    Puck is in binary mode — auto-fix with:"
            echo "      sudo gpsctl -f -n $gps_dev"
            echo "      sudo systemctl restart droneaware-wifi"
            echo "      sudo droneaware gps-diagnose   # to re-verify"
            ;;
        unknown) echo "    Could not identify protocol. Check the puck's power/wiring and try 'sudo dmesg | tail -20'." ;;
        "")      echo "    Not enough data yet. Wait ~10s for wifi_feeder to detect and re-run." ;;
    esac
    echo ""
}

case "$1" in
    update)         cmd_update ;;
    status)         cmd_status ;;
    logs)           cmd_logs "$@" ;;
    test)           cmd_test "$@" ;;
    install-webui)  cmd_install_webui ;;
    gps-diagnose)   cmd_gps_diagnose ;;
    refresh)        cmd_refresh ;;
    __migrate)
        # Internal subcommand used by cmd_update for post-install config
        # migration. The double-underscore prefix is a convention signaling
        # "private — operators shouldn't need to call this." Intentionally
        # NOT mentioned in the help text below.
        #
        # Safe to call manually for testing — it's just migrate_config_env,
        # which is idempotent and writes a timestamped backup of config.env
        # before any modification.
        require_root "__migrate"
        migrate_config_env
        ;;
    *)
        echo ""
        echo -e "${BOLD}DroneAware Node CLI${NC}"
        echo ""
        echo "  Usage: sudo droneaware <command>"
        echo ""
        echo "  Commands:"
        echo "    update          Download and install the latest firmware"
        echo "    status          Show service status and firmware version"
        echo "    logs            Tail live logs  (wifi by default, or: droneaware logs ble)"
        echo "    test            Transmit a 60-second test flight and verify detection"
        echo "    test --dry-run  Check rate-limit availability without transmitting"
        echo "    install-webui   Install the optional local Web UI (LAN dashboard)"
        echo "    gps-diagnose    Read-only GPS health check (device, port, protocol, state)"
        echo "    refresh         Re-detect hardware (WiFi adapters, GPS) and sync services"
        echo ""
        ;;
esac
